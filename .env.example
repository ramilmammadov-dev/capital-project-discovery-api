# Copy to .env and fill in. .env is git-ignored.

# --- Model / search providers -------------------------------------------------
# Claude (default extraction model, LLM-assisted web search, escalation model)
ANTHROPIC_API_KEY=
# Jev (TypeSafe) — primary chunk-screening classifier. Without it a free local screener is used
# and every report/metric states that explicitly.
TYPESAFE_API_KEY=
# Optional alternatives (any OpenAI-compatible endpoint works: OpenAI, GLM/Zhipu, DeepSeek, vLLM, ...)
OPENAI_API_KEY=
# Optional search APIs (used in addition to / instead of Claude web search)
BRAVE_API_KEY=
SERPER_API_KEY=

# --- Service -----------------------------------------------------------------
# Comma-separated API keys accepted by this service (X-API-Key header)
CAPEX_API_KEYS=dev-local-key
# Optional overrides
# CAPEX_CONFIG=config/capex.yaml
# CAPEX_DATA_DIR=data
# CAPEX_DATABASE_URL=sqlite:///data/capex.db
